{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bdd/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist", "dist-bdd"]
}
