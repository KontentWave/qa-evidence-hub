{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API process is live",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check API process liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getHealthReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "API and PostgreSQL connection are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessOkResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "API cannot verify PostgreSQL readiness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailableResponseDto"
                }
              }
            }
          }
        },
        "summary": "Check API database readiness via bounded SELECT 1",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "operationId": "getAuthCsrfToken",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Browser-bound anti-CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Insecure transport rejected when HTTPS origin is configured"
          }
        },
        "summary": "Bootstrap browser-bound pre-login or session-bound anti-CSRF token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginOwner",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Browser-bound anti-CSRF token obtained from GET /api/v1/auth/csrf",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Owner authenticated; fresh session cookie and authenticated CSRF token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login payload or undeclared DTO fields"
          },
          "401": {
            "description": "Generic authentication failure"
          },
          "403": {
            "description": "Missing or invalid Origin or X-CSRF-Token"
          },
          "429": {
            "description": "Bounded login rate limit exceeded"
          }
        },
        "summary": "Authenticate the provisioned single owner and issue a fresh session cookie",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Active authenticated owner session summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionStatusResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or revoked session"
          }
        },
        "summary": "Read-only authenticated owner session lookup (emits zero Set-Cookie headers)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logoutOwner",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound anti-CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyBodyDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session invalidated and cookie cleared",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Missing or invalid Origin or X-CSRF-Token"
          }
        },
        "summary": "Invalidate the current owner session and clear browser auth cookies",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/clients": {
      "post": {
        "operationId": "createClient",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound anti-CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Client created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or undeclared DTO fields supplied"
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Missing or invalid Origin or X-CSRF-Token"
          }
        },
        "summary": "Create a client engagement container",
        "tags": [
          "clients"
        ]
      },
      "get": {
        "operationId": "listClients",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Client list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientListResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required"
          }
        },
        "summary": "List clients newest-first",
        "tags": [
          "clients"
        ]
      }
    },
    "/api/v1/clients/{clientId}": {
      "get": {
        "operationId": "getClient",
        "parameters": [
          {
            "name": "clientId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "11111111-2222-4333-8444-555555555555",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Client details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid client ID format"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Client was not found"
          }
        },
        "summary": "Get client details by ID",
        "tags": [
          "clients"
        ]
      }
    },
    "/api/v1/clients/{clientId}/projects": {
      "post": {
        "operationId": "createClientProject",
        "parameters": [
          {
            "name": "clientId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "11111111-2222-4333-8444-555555555555",
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound anti-CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created as Active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed or undeclared DTO fields supplied"
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Missing or invalid Origin or X-CSRF-Token"
          },
          "404": {
            "description": "Parent client was not found"
          }
        },
        "summary": "Create an active project under the specified client",
        "tags": [
          "projects"
        ]
      },
      "get": {
        "operationId": "listClientProjects",
        "parameters": [
          {
            "name": "clientId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "11111111-2222-4333-8444-555555555555",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Client project list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid client ID format"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Parent client was not found"
          }
        },
        "summary": "List projects belonging to the specified client newest-first",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/clients/{clientId}/projects/{projectId}": {
      "get": {
        "operationId": "getClientProject",
        "parameters": [
          {
            "name": "clientId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "11111111-2222-4333-8444-555555555555",
              "type": "string"
            }
          },
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "22222222-3333-4444-8555-666666666666",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid client or project ID format"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Client or project was not found, or parent mismatch"
          }
        },
        "summary": "Get project details scoped to its parent client",
        "tags": [
          "projects"
        ]
      }
    },
    "/api/v1/projects/{projectId}/sessions": {
      "post": {
        "operationId": "createProjectSession",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "22222222-3333-4444-8555-666666666666",
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Session-bound anti-CSRF token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Test session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed (including invalid time range or undeclared DTO fields)"
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Missing or invalid Origin or X-CSRF-Token"
          },
          "404": {
            "description": "Parent project was not found"
          },
          "409": {
            "description": "Parent project is archived and read-only"
          }
        },
        "summary": "Create a test session under an active project",
        "tags": [
          "sessions"
        ]
      },
      "get": {
        "operationId": "listProjectSessions",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "22222222-3333-4444-8555-666666666666",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project test session list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionListResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid project ID format"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Parent project was not found"
          }
        },
        "summary": "List test sessions belonging to the specified project newest-first",
        "tags": [
          "sessions"
        ]
      }
    },
    "/api/v1/projects/{projectId}/sessions/{sessionId}": {
      "get": {
        "operationId": "getProjectSession",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "22222222-3333-4444-8555-666666666666",
              "type": "string"
            }
          },
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "example": "33333333-4444-4555-8666-777777777777",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Test session details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid project or session ID format"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Project or test session was not found, or parent mismatch"
          }
        },
        "summary": "Get test session details scoped to its parent project",
        "tags": [
          "sessions"
        ]
      }
    }
  },
  "info": {
    "title": "QA Evidence Hub API",
    "description": "Phase 1 HTTP API contract for QA Evidence Hub",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessOkResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ],
            "example": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadinessUnavailableResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "not_ready"
            ],
            "example": "not_ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "CsrfTokenResponseDto": {
        "type": "object",
        "properties": {
          "csrfToken": {
            "type": "string",
            "example": "dG9rZW4tZXhhbXBsZS1vcGFxdWUtY3NyZg"
          }
        },
        "required": [
          "csrfToken"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "loginIdentifier": {
            "type": "string",
            "example": "owner@example.test",
            "maxLength": 200
          },
          "password": {
            "type": "string",
            "example": "••••••••••••",
            "maxLength": 1024
          }
        },
        "required": [
          "loginIdentifier",
          "password"
        ]
      },
      "OwnerSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "11111111-2222-4333-8444-555555555555"
          },
          "loginIdentifier": {
            "type": "string",
            "example": "owner@example.test"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Bratislava"
          }
        },
        "required": [
          "id",
          "loginIdentifier",
          "timezone"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerSummaryDto"
          },
          "csrfToken": {
            "type": "string",
            "example": "Y2hhbmdlZC1hdXRoZW50aWNhdGVkLWNzcmYtdG9rZW4"
          }
        },
        "required": [
          "authenticated",
          "owner",
          "csrfToken"
        ]
      },
      "SessionStatusResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              true
            ],
            "example": true
          },
          "owner": {
            "$ref": "#/components/schemas/OwnerSummaryDto"
          }
        },
        "required": [
          "authenticated",
          "owner"
        ]
      },
      "EmptyBodyDto": {
        "type": "object",
        "properties": {}
      },
      "LogoutResponseDto": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "enum": [
              false
            ],
            "example": false
          }
        },
        "required": [
          "authenticated"
        ]
      },
      "CreateClientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Example Client",
            "minLength": 1,
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000,
            "example": "Synthetic engagement notes"
          }
        },
        "required": [
          "name"
        ]
      },
      "ClientDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-2222-4333-8444-555555555555"
          },
          "name": {
            "type": "string",
            "example": "Example Client"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "example": "Synthetic engagement notes"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-06T09:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-06T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "notes",
          "createdAt",
          "updatedAt"
        ]
      },
      "ClientListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Checkout QA",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000,
            "example": "Checkout payment and order confirmation regression"
          },
          "testingContext": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000,
            "example": "Staging sandbox with synthetic test cards"
          },
          "instructions": {
            "type": "string",
            "nullable": true,
            "maxLength": 20000,
            "example": "Capture viewport and build version on payment errors."
          }
        },
        "required": [
          "name"
        ]
      },
      "ProjectDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "22222222-3333-4444-8555-666666666666"
          },
          "clientId": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-2222-4333-8444-555555555555"
          },
          "name": {
            "type": "string",
            "example": "Checkout QA"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Archived"
            ],
            "example": "Active"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "testingContext": {
            "type": "string",
            "nullable": true
          },
          "instructions": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-06T09:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-06T09:00:00.000Z"
          }
        },
        "required": [
          "id",
          "clientId",
          "name",
          "status",
          "description",
          "testingContext",
          "instructions",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "example": "Checkout regression",
            "minLength": 1,
            "maxLength": 200
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-06T09:00:00Z"
          },
          "endedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time",
            "example": "2026-10-06T10:30:00Z"
          },
          "environment": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "example": "staging"
          },
          "device": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "example": "Desktop"
          },
          "os": {
            "type": "string",
            "nullable": true,
            "maxLength": 200,
            "example": "Linux"
          },
          "browser": {
            "type": "string",
