# QA Evidence Hub — Synthetic local development & container defaults (P1-01)
# Never store real credentials, R2 keys, or client data in .env files inside the repository.

# PostgreSQL 19 service & candidate VPS tuning defaults (§6.4)
POSTGRES_DB=qaeh_local
POSTGRES_USER=qaeh_app
POSTGRES_PASSWORD=qaeh_synthetic_local_only_password
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAX_CONNECTIONS=30

# NestJS API runtime configuration (apps/api only — never exposed to apps/web)
NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:8080
DATABASE_URL=postgresql://qaeh_app:qaeh_synthetic_local_only_password@postgres:5432/qaeh_local?schema=public
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
# Explicit Nginx ingress proxy trust (`false`, `loopback`, explicit IP/CIDR, or `nginx`; wildcard/hop-counts rejected)
TRUST_PROXY=nginx
# Adaptive scrypt log2(N) work factor (`14`..`16` within 128 MiB per-hash limit; `17` and `18` rejected)
AUTH_PASSWORD_SCRYPT_LN=16
# Per-IP failed + in-flight login attempt cap before 429 throttling (`1`..`50`)
AUTH_LOGIN_MAX_ATTEMPTS=5

# Next.js SSR internal API origin (apps/web server-only — never NEXT_PUBLIC_*)
INTERNAL_API_BASE_URL=http://api:3001

# Local Nginx reverse-proxy HTTP listener (production TLS arrives in P1-11 / F03)
NGINX_HTTP_PORT=8080

# Production Compose image references (required when running compose.yaml directly without compose.dev.yaml).
# Private GHCR publishing arrives in P1-02; supply real @sha256:<64-hex> references for production deploys.
# API_IMAGE=ghcr.io/<owner>/qa-evidence-hub-api@sha256:<64-hex>
# WEB_IMAGE=ghcr.io/<owner>/qa-evidence-hub-web@sha256:<64-hex>
