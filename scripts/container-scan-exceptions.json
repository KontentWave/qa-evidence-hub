      "target": "/etc/ssl/private/ssl-cert-snakeoil.key",
      "ruleId": "private-key",
      "reviewedAt": "2026-11-21",
      "reviewedBy": "KontentWave",
      "expiresOn": "2027-02-19",
      "docRef": ".github/docs/runbook.md#4-dependency-and-container-vulnerability-policy",
      "rationale": "Stock Debian ssl-cert package placeholder snakeoil key baked into official debian:bookworm / postgres:17-bookworm base layers; PostgreSQL runs unexposed on Docker internal:true data_net and never uses this snakeoil key for public or client TLS."
